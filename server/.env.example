PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jewellery_store
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
# Cloudinary image storage (get credentials from cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Razorpay payment gateway (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
